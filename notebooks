      "source": [
        "!pip install pandas_ta xgboost scikit-learn -q\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import requests\n",
        "import xgboost as xgb\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "# ══════════════════════════════════════════════════════\n",
        "# НАСТРОЙКИ (актуалните от бота v4 след промяната)\n",
        "# ══════════════════════════════════════════════════════\n",
        "INITIAL_BALANCE  = 50000\n",
        "TRADE_SIZE_PCT   = 70\n",
        "STOP_LOSS_PCT    = 5\n",
        "TAKE_PROFIT_PCT  = 6\n",
        "TRAIL_START_PCT  = 4\n",
        "TRAIL_DIST_PCT   = 3\n",
        "FEE_PCT          = 0.055\n",
        "WARMUP           = 250\n",
        "\n",
        "# ══════════════════════════════════════════════════════\n",
        "# 1. ИСТОРИЧЕСКИ ДАННИ — 5 години\n",
        "# ══════════════════════════════════════════════════════\n",
        "def get_history(days=1825):\n",
        "    # Опит 1: Binance data API (data-api.binance.vision — публичен, без гео-блок)\n",
        "    try:\n",
        "        all_data = []\n",
        "        end_time = None\n",
        "        while len(all_data) < days:\n",
        "            params = {\"symbol\": \"BTCUSDT\", \"interval\": \"1d\", \"limit\": 1000}\n",
        "            if end_time:\n",
        "                params[\"endTime\"] = end_time\n",
        "            r = requests.get(\"https://data-api.binance.vision/api/v3/klines\",\n",
        "                             params=params, timeout=20)\n",
        "            batch = r.json()\n",
        "            if not isinstance(batch, list) or not batch:\n",
        "                break\n",
        "            all_data = batch + all_data\n",
        "            end_time = batch[0][0] - 1\n",
        "            if len(batch) < 1000:\n",
        "                break\n",
        "        if len(all_data) >= 500:\n",
        "            df = pd.DataFrame(all_data, columns=[\"ts\",\"open\",\"high\",\"low\",\"close\",\n",
        "                \"volume\",\"ct\",\"qav\",\"n\",\"tb\",\"tq\",\"ig\"])\n",
        "            for c in [\"open\",\"high\",\"low\",\"close\",\"volume\"]:\n",
        "                df[c] = df[c].astype(float)\n",
        "            df[\"date\"] = pd.to_datetime(df[\"ts\"], unit=\"ms\")\n",
        "            df = df.drop_duplicates(subset=\"ts\").sort_values(\"date\")\n",
        "            df = df[[\"date\",\"open\",\"high\",\"low\",\"close\",\"volume\"]].tail(days)\n",
        "            print(f\"✅ Източник: Binance Vision\")\n",
        "            return df.reset_index(drop=True)\n",
        "    except Exception as e:\n",
        "        print(f\"⚠️ Binance Vision: {e}\")\n",
        "\n",
        "    # Опит 2: CoinGecko (365-дневни парчета, само close — приемаме o=h=l=c)\n",
        "    print(\"🔄 Опитвам CoinGecko на парчета...\")\n",
        "    import time as t\n",
        "    frames = []\n",
        "    now = pd.Timestamp.now()\n",
        "    for k in range(5):\n",
        "        try:\n",
        "            fr = int((now - pd.Timedelta(days=365*(k+1))).timestamp())\n",
        "            to = int((now - pd.Timedelta(days=365*k)).timestamp())\n",
        "            r = requests.get(\n",
        "                \"https://api.coingecko.com/api/v3/coins/bitcoin/market_chart/range\",\n",
        "                params={\"vs_currency\":\"usd\",\"from\":fr,\"to\":to}, timeout=20)\n",
        "            prices = r.json().get(\"prices\", [])\n",
        "            if prices:\n",
        "                d = pd.DataFrame(prices, columns=[\"ts\",\"close\"])\n",
        "                frames.append(d)\n",
        "            t.sleep(12)  # rate limit на CoinGecko\n",
        "        except Exception as e:\n",
        "            print(f\"⚠️ Парче {k}: {e}\")\n",
        "    df = pd.concat(frames).drop_duplicates(subset=\"ts\").sort_values(\"ts\")\n",
        "    df[\"date\"] = pd.to_datetime(df[\"ts\"], unit=\"ms\")\n",
        "    df = df.set_index(\"date\").resample(\"1D\").last().dropna().reset_index()\n",
        "    df[\"open\"] = df[\"close\"].shift(1)\n",
        "    df[\"high\"] = df[[\"open\",\"close\"]].max(axis=1)\n",
        "    df[\"low\"]  = df[[\"open\",\"close\"]].min(axis=1)\n",
        "    df[\"volume\"] = 0\n",
        "    df = df.dropna()\n",
        "    print(f\"✅ Източник: CoinGecko\")\n",
        "    return df[[\"date\",\"open\",\"high\",\"low\",\"close\",\"volume\"]].reset_index(drop=True)\n",
        "\n",
        "print(\"📥 Изтеглям 5 години данни...\")\n",
        "df = get_history(1825)\n",
        "print(f\"✅ {len(df)} дни: {df['date'].min().date()} → {df['date'].max().date()}\")\n",
        "\n",
        "# ══════════════════════════════════════════════════════\n",
        "# 2. FEAR & GREED ИСТОРИЯ (пълна)\n",
        "# ══════════════════════════════════════════════════════\n",
        "print(\"📥 Изтеглям Fear & Greed история...\")\n",
        "fg = requests.get(\"https://api.alternative.me/fng/?limit=0\", timeout=15).json()[\"data\"]\n",
        "fg_df = pd.DataFrame(fg)\n",
        "fg_df[\"date\"] = pd.to_datetime(fg_df[\"timestamp\"].astype(int), unit=\"s\").dt.normalize()\n",
        "fg_df[\"fg\"]   = fg_df[\"value\"].astype(int)\n",
        "df[\"date_n\"] = df[\"date\"].dt.normalize()\n",
        "df = df.merge(fg_df[[\"date\",\"fg\"]], left_on=\"date_n\", right_on=\"date\",\n",
        "              how=\"left\", suffixes=(\"\",\"_fg\")).drop(columns=[\"date_fg\",\"date_n\"])\n",
        "df[\"fg\"] = df[\"fg\"].fillna(50)\n",
        "print(\"✅ Fear & Greed слят\")\n",
        "\n",
        "# ══════════════════════════════════════════════════════\n",
        "# 3. ТЕХНИЧЕСКИ ИНДИКАТОРИ (ръчно, без pandas_ta)\n",
        "# ══════════════════════════════════════════════════════\n",
        "print(\"⚙️ Изчислявам индикатори...\")\n",
        "\n",
        "def calc_rsi(close, length=14):\n",
        "    delta = close.diff()\n",
        "    gain = delta.clip(lower=0).ewm(alpha=1/length, min_periods=length).mean()\n",
        "    loss = (-delta.clip(upper=0)).ewm(alpha=1/length, min_periods=length).mean()\n",
        "    rs = gain / loss\n",
        "    return 100 - (100 / (1 + rs))\n",
        "\n",
        "def calc_ema(close, length):\n",
        "    return close.ewm(span=length, adjust=False).mean()\n",
        "\n",
        "# RSI\n",
        "df[\"rsi\"] = calc_rsi(df[\"close\"], 14)\n",
        "\n",
        "# MACD (12, 26, 9)\n",
        "ema12 = calc_ema(df[\"close\"], 12)\n",
        "ema26 = calc_ema(df[\"close\"], 26)\n",
        "df[\"macd\"]  = ema12 - ema26\n",
        "df[\"macds\"] = df[\"macd\"].ewm(span=9, adjust=False).mean()\n",
        "\n",
        "# EMA-та\n",
        "df[\"ema20\"]  = calc_ema(df[\"close\"], 20)\n",
        "df[\"ema50\"]  = calc_ema(df[\"close\"], 50)\n",
        "df[\"ema200\"] = calc_ema(df[\"close\"], 200)\n",
        "\n",
        "# Bollinger Bands (20, 2)\n",
        "ma20 = df[\"close\"].rolling(20).mean()\n",
        "std20 = df[\"close\"].rolling(20).std()\n",
        "df[\"bbu\"] = ma20 + 2 * std20\n",
        "df[\"bbl\"] = ma20 - 2 * std20\n",
        "\n",
        "def tech_score(row):\n",
        "    buy = sell = 0\n",
        "    if row[\"rsi\"] < 30:   buy += 3\n",
        "    elif row[\"rsi\"] > 70: sell += 3\n",
        "    else:                  buy += 1\n",
        "    if row[\"macd\"] > row[\"macds\"]: buy += 2\n",
        "    else:                           sell += 2\n",
        "    if row[\"close\"] > row[\"ema20\"]:  buy += 1\n",
        "    else:                             sell += 1\n",
        "    if row[\"close\"] > row[\"ema50\"]:  buy += 1\n",
        "    else:                             sell += 1\n",
        "    if row[\"close\"] > row[\"ema200\"]: buy += 2\n",
        "    else:                             sell += 2\n",
        "    if row[\"close\"] < row[\"bbl\"]:   buy += 2\n",
        "    elif row[\"close\"] > row[\"bbu\"]: sell += 2\n",
        "    return buy - sell\n",
        "\n",
        "df[\"tech\"] = df.apply(tech_score, axis=1)\n",
        "\n",
        "def get_trend(row):\n",
        "    if row[\"close\"] > row[\"ema50\"] > row[\"ema200\"]:  return \"STRONG_UP\"\n",
