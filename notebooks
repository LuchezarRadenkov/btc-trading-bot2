        "SHEET_ID         = \"1s5IDfZLrqNRmuTzL-xZw7fhCw2-Ct6ZLveScYbV3LgQ\"\n",
        "\n",
        "with open(\"/content/affable-curve-493911-e7-5e8442e3df13.json\") as f:\n",
        "    GOOGLE_CREDENTIALS = json.load(f)\n",
        "\n",
        "def send_telegram(message):\n",
        "    url = f\"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage\"\n",
        "    payload = {\"chat_id\": TELEGRAM_CHAT_ID, \"text\": message, \"parse_mode\": \"HTML\"}\n",
        "    try:\n",
        "        requests.post(url, data=payload, timeout=5)\n",
        "    except Exception as e:\n",
        "        st.warning(f\"Telegram грешка: {e}\")\n",
        "\n",
        "def get_btc_price():\n",
        "    try:\n",
        "        url = \"https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT\"\n",
        "        r   = requests.get(url, timeout=5)\n",
        "        return float(r.json()[\"price\"])\n",
        "    except:\n",
        "        try:\n",
        "            url = \"https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd\"\n",
        "            r   = requests.get(url, timeout=5)\n",
        "            return float(r.json()[\"bitcoin\"][\"usd\"])\n",
        "        except:\n",
        "            url = \"https://api.coinbase.com/v2/prices/BTC-USD/spot\"\n",
        "            r   = requests.get(url, timeout=5)\n",
        "            return float(r.json()[\"data\"][\"amount\"])\n",
        "\n",
        "def get_btc_history():\n",
        "    url    = \"https://api.binance.com/api/v3/klines\"\n",
        "    params = {\"symbol\": \"BTCUSDT\", \"interval\": \"1h\", \"limit\": 1000}\n",
        "    r      = requests.get(url, params=params, timeout=5)\n",
        "    data   = r.json()\n",
        "    df     = pd.DataFrame(data, columns=[\n",
        "        \"open_time\",\"open\",\"high\",\"low\",\"close\",\"volume\",\n",
        "        \"close_time\",\"qav\",\"trades\",\"tbbav\",\"tbqav\",\"ignore\"\n",
        "    ])\n",
        "    df[\"close\"]     = df[\"close\"].astype(float)\n",
        "    df[\"open_time\"] = pd.to_datetime(df[\"open_time\"], unit=\"ms\").dt.tz_localize(\"UTC\").dt.tz_convert(\"Europe/Sofia\")\n",
        "    return df\n",
        "\n",
        "def load_signals():\n",
        "    try:\n",
        "        scopes = [\"https://www.googleapis.com/auth/spreadsheets\"]\n",
        "        creds  = Credentials.from_service_account_info(GOOGLE_CREDENTIALS, scopes=scopes)\n",
        "        client = gspread.authorize(creds)\n",
        "        sheet  = client.open_by_key(SHEET_ID).worksheet(\"Combined\")\n",
        "        data   = sheet.get_all_records()\n",
        "        df     = pd.DataFrame(data)\n",
        "        # Преименувай final_signal на signal за съвместимост\n",
        "        if \"final_signal\" in df.columns:\n",
        "            df[\"signal\"] = df[\"final_signal\"]\n",
        "        return df\n",
        "    except Exception as e:\n",
        "        st.warning(f\"Грешка при четене от Sheets: {e}\")\n",
        "        return pd.DataFrame()\n",
        "\n",
        "def signal_color(signal):\n",
        "    s = str(signal).upper()\n",
        "    if \"BUY\" in s:  return \"green\"\n",
        "    if \"SELL\" in s: return \"red\"\n",
        "    return \"white\"\n",
        "\n",
        "def signal_emoji(signal):\n",
        "    s = str(signal).upper()\n",
        "    if \"STRONG BUY\" in s:  return \"🚀\"\n",
        "    if \"BUY\" in s:         return \"📈\"\n",
        "    if \"STRONG SELL\" in s: return \"🔴\"\n",
        "    if \"SELL\" in s:        return \"📉\"\n",
        "    return \"⏸️\"\n",
        "\n",
