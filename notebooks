        "import requests\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "def get_volume_data():\n",
        "    \"\"\"Взима обем от CoinGecko - безплатно без API ключ\"\"\"\n",
        "    url = \"https://api.coingecko.com/api/v3/coins/bitcoin/market_chart\"\n",
        "    params = {\"vs_currency\": \"usd\", \"days\": 30, \"interval\": \"daily\"}\n",
        "    r = requests.get(url, params=params, timeout=10)\n",
        "    cg = r.json()\n",
        "\n",
        "    prices  = cg.get(\"prices\", [])\n",
        "    volumes = cg.get(\"total_volumes\", [])\n",
        "\n",
        "    rows = []\n",
        "    for i in range(1, min(len(prices), len(volumes))):\n",
        "        price     = prices[i][1]\n",
        "        prev_price = prices[i-1][1]\n",
        "        vol_usd   = volumes[i][1]\n",
        "        vol_btc   = vol_usd / price if price > 0 else 0\n",
        "        rows.append({\n",
        "            \"open_time\": pd.to_datetime(prices[i][0], unit=\"ms\"),\n",
        "            \"open\":      prev_price,\n",
        "            \"high\":      max(price, prev_price),\n",
        "            \"low\":       min(price, prev_price),\n",
        "            \"close\":     price,\n",
        "            \"volume\":    vol_btc,\n",
        "            \"volume_usd\": vol_usd,\n",
        "            \"trades\":    0\n",
        "        })\n",
        "\n",
        "    df = pd.DataFrame(rows)\n",
        "    print(f\"✅ Данни от CoinGecko: {len(df)} дни\")\n",
        "    return df\n",
        "\n",
        "def get_exchange_volumes():\n",
        "    exchanges = {}\n",
        "    try:\n",
        "        r = requests.get(\"https://api.exchange.coinbase.com/products/BTC-USD/stats\", timeout=5)\n",
        "        d = r.json()\n",
        "        exchanges[\"Coinbase\"] = float(d[\"volume\"]) * float(d[\"last\"])\n",
        "    except:\n",
        "        pass\n",
        "    try:\n",
        "        r = requests.get(\"https://api.kraken.com/0/public/Ticker?pair=XBTUSD\", timeout=5)\n",
        "        d = r.json()\n",
        "        result = d[\"result\"]\n",
        "        key   = list(result.keys())[0]\n",
        "        vol   = float(result[key][\"v\"][1])\n",
        "        price = float(result[key][\"c\"][0])\n",
        "        exchanges[\"Kraken\"] = vol * price\n",
        "    except:\n",
        "        pass\n",
        "    try:\n",
        "        r = requests.get(\"https://api.coingecko.com/api/v3/exchanges/binance\", timeout=5)\n",
        "        d = r.json()\n",
        "        exchanges[\"Binance\"] = float(d.get(\"trade_volume_24h_btc\", 0))\n",
        "    except:\n",
        "        pass\n",
        "    return exchanges\n",
        "\n",
        "def analyze_volume(df):\n",
        "    if len(df) < 2:\n",
        "        raise ValueError(\"Недостатъчно данни!\")\n",
        "\n",
        "    avg_volume_7d  = df[\"volume\"].tail(7).mean()\n",
        "    avg_volume_30d = df[\"volume\"].mean()\n",
        "    current_volume = df[\"volume\"].iloc[-1]\n",
        "    current_price  = df[\"close\"].iloc[-1]\n",
        "    prev_price     = df[\"close\"].iloc[-2]\n",
        "    price_change   = (current_price - prev_price) / prev_price * 100\n",
        "    volume_ratio   = current_volume / avg_volume_30d\n",
        "\n",
        "    score   = 0\n",
        "    reasons = []\n",
        "\n",
        "    if volume_ratio >= 1.5:\n",
        "        score += 3\n",
        "        reasons.append(f\"✅ Много висок обем: {volume_ratio:.1f}x над средния\")\n",
        "    elif volume_ratio >= 1.2:\n",
        "        score += 2\n",
        "        reasons.append(f\"✅ Висок обем: {volume_ratio:.1f}x над средния\")\n",
        "    elif volume_ratio >= 0.8:\n",
        "        reasons.append(f\"➡️ Нормален обем: {volume_ratio:.1f}x спрямо средния\")\n",
        "    else:\n",
        "        score -= 2\n",
        "        reasons.append(f\"⚠️ Нисък обем: {volume_ratio:.1f}x под средния\")\n",
        "\n",
        "    if volume_ratio >= 1.2 and price_change > 0:\n",
        "        score += 2\n",
        "        reasons.append(f\"✅ Висок обем + растяща цена (+{price_change:.2f}%) — силен BUY сигнал\")\n",
        "    elif volume_ratio >= 1.2 and price_change < 0:\n",
        "        score -= 2\n",
        "        reasons.append(f\"⚠️ Висок обем + падаща цена ({price_change:.2f}%) — силен SELL сигнал\")\n",
        "    elif volume_ratio < 0.8 and price_change > 0:\n",
        "        score -= 1\n",
        "        reasons.append(f\"⚠️ Нисък обем + растяща цена — слаб сигнал\")\n",
        "\n",
        "    vol_trend = df[\"volume\"].tail(7).is_monotonic_increasing\n",
        "    if vol_trend:\n",
        "        score += 1\n",
        "        reasons.append(\"✅ Обемът расте последните 7 дни\")\n",
        "\n",
        "    if score >= 4:    signal = \"STRONG BULLISH 🚀\"\n",
        "    elif score >= 2:  signal = \"BULLISH 📈\"\n",
        "    elif score <= -4: signal = \"STRONG BEARISH 🔴\"\n",
        "    elif score <= -2: signal = \"BEARISH 📉\"\n",
        "    else:             signal = \"NEUTRAL ⏸️\"\n",
        "\n",
        "    return signal, reasons, {\n",
        "        \"current_volume\":  current_volume,\n",
        "        \"current_vol_usd\": df[\"volume_usd\"].iloc[-1],\n",
        "        \"avg_volume_7d\":   avg_volume_7d,\n",
        "        \"avg_volume_30d\":  avg_volume_30d,\n",
        "        \"volume_ratio\":    volume_ratio,\n",
        "        \"price_change\":    price_change,\n",
        "        \"current_price\":   current_price\n",
        "    }\n",
        "\n",
        "# ── Пусни анализа ───────────────────────────────────────────\n",
        "print(\"Изтеглям данни за обема...\")\n",
        "df = get_volume_data()\n",
        "signal, reasons, stats = analyze_volume(df)\n",
        "exchanges = get_exchange_volumes()\n",
        "\n",
        "print(f\"\\n========== VOLUME АНАЛИЗ ==========\")\n",
        "print(f\"💰 BTC Цена:              ${stats['current_price']:,.2f}\")\n",
        "print(f\"📊 Обем днес (BTC):       {stats['current_volume']:,.2f} BTC\")\n",
        "print(f\"📊 Обем днес (USD):       ${stats['current_vol_usd']:,.0f}\")\n",
        "print(f\"📈 Среден обем (7д):      {stats['avg_volume_7d']:,.2f} BTC\")\n",
        "print(f\"📉 Среден обем (30д):     {stats['avg_volume_30d']:,.2f} BTC\")\n",
        "print(f\"⚖️  Ratio (днес/30д avg): {stats['volume_ratio']:.2f}x\")\n",
        "print(f\"📅 Промяна на цената:     {stats['price_change']:+.2f}%\")\n",
        "print(f\"====================================\")\n",
        "\n",
        "print(f\"\\n========== АНАЛИЗ ==========\")\n",
        "for reason in reasons:\n",
        "    print(f\"  {reason}\")\n",
        "print(f\"\\n🔔 Краен сигнал: {signal}\")\n",
        "print(f\"============================\")\n",
        "\n",
        "if exchanges:\n",
        "    print(f\"\\n========== ОБЕМ ПО БОРСИ (24ч) ==========\")\n",
        "    for exchange, vol in sorted(exchanges.items(), key=lambda x: x[1], reverse=True):\n",
        "        print(f\"  {exchange:12} ${vol:>20,.0f}\")\n",
        "    print(f\"==========================================\")\n",
        "\n",
        "# ── Графика ─────────────────────────────────────────────────\n",
        "fig = make_subplots(\n",
        "    rows=2, cols=1,\n",
        "    shared_xaxes=True,\n",
        "    subplot_titles=(\"BTC Цена (USD)\", \"Обем на търговията (BTC)\"),\n",
        "    row_heights=[0.6, 0.4],\n",
        "    vertical_spacing=0.05\n",
        ")\n",
        "\n",
        "fig.add_trace(go.Candlestick(\n",
        "    x=df[\"open_time\"],\n",
        "    open=df[\"open\"],\n",
        "    high=df[\"high\"],\n",
        "    low=df[\"low\"],\n",
        "    close=df[\"close\"],\n",
        "    name=\"BTC\",\n",
        "    increasing_line_color=\"green\",\n",
        "    decreasing_line_color=\"red\"\n",
        "), row=1, col=1)\n",
        "\n",
        "avg_30d = df[\"volume\"].mean()\n",
        "fig.add_hline(\n",
        "    y=avg_30d,\n",
        "    line_dash=\"dash\",\n",
        "    line_color=\"yellow\",\n",
        "    annotation_text=f\"Среден обем 30д: {avg_30d:,.0f}\",\n",
        "    row=2, col=1\n",
        ")\n",
        "\n",
        "volume_colors = [\n",
        "    \"green\" if df[\"close\"].iloc[i] >= df[\"open\"].iloc[i] else \"red\"\n",
        "    for i in range(len(df))\n",
        "]\n",
        "fig.add_trace(go.Bar(\n",
        "    x=df[\"open_time\"],\n",
        "    y=df[\"volume\"],\n",
        "    name=\"Обем\",\n",
        "    marker_color=volume_colors,\n",
        "    hovertemplate=\"Дата: %{x}<br>Обем: %{y:,.0f} BTC<extra></extra>\"\n",
        "), row=2, col=1)\n",
        "\n",
        "fig.update_layout(\n",
        "    title=f\"BTC Volume Анализ | Сигнал: {signal}\",\n",
        "    paper_bgcolor=\"#0E1117\",\n",
        "    plot_bgcolor=\"#0E1117\",\n",
        "    font=dict(color=\"white\"),\n",
        "    xaxis=dict(gridcolor=\"#1E2130\"),\n",
        "    xaxis2=dict(gridcolor=\"#1E2130\", title=\"Дата\"),\n",
        "    yaxis=dict(gridcolor=\"#1E2130\", title=\"Цена (USD)\"),\n",
        "    yaxis2=dict(gridcolor=\"#1E2130\", title=\"Обем (BTC)\"),\n",
        "    height=600,\n",
        "    xaxis_rangeslider_visible=False,\n",
        "    showlegend=False\n",
        ")\n",
        "\n",
        "fig.show()"
      ]
    },
