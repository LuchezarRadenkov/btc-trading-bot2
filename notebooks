        "def get_btc_news():\n",
        "    \"\"\"Взима новини от RSS feeds\"\"\"\n",
        "    news = []\n",
        "    feeds = [\n",
        "        \"https://cointelegraph.com/rss\",\n",
        "        \"https://coindesk.com/arc/outboundfeeds/rss/\",\n",
        "        \"https://bitcoinmagazine.com/.rss/full/\",\n",
        "    ]\n",
        "    for feed_url in feeds:\n",
        "        try:\n",
        "            feed = feedparser.parse(feed_url)\n",
        "            for entry in feed.entries[:10]:\n",
        "                news.append({\"title\": entry.title})\n",
        "        except:\n",
        "            continue\n",
        "    return news\n",
        "\n",
        "def analyze_sentiment_keywords(title):\n",
        "    title_lower = title.lower()\n",
        "    bullish_words = [\n",
        "        \"surge\", \"rally\", \"bull\", \"gain\", \"rise\", \"up\", \"high\", \"buy\",\n",
        "        \"positive\", \"growth\", \"pump\", \"breakout\", \"support\", \"adoption\",\n",
        "        \"record\", \"profit\", \"win\", \"boost\", \"strong\", \"recovery\", \"jump\",\n",
        "        \"купува\", \"расте\", \"ръст\", \"покачване\"\n",
        "    ]\n",
        "    bearish_words = [\n",
        "        \"crash\", \"drop\", \"fall\", \"bear\", \"loss\", \"down\", \"low\", \"sell\",\n",
        "        \"negative\", \"decline\", \"dump\", \"breakdown\", \"resistance\", \"fear\",\n",
        "        \"ban\", \"hack\", \"scam\", \"risk\", \"warning\", \"correction\", \"plunge\",\n",
        "        \"пада\", \"срив\", \"спад\", \"загуба\"\n",
        "    ]\n",
        "    bull_count = sum(1 for w in bullish_words if w in title_lower)\n",
        "    bear_count = sum(1 for w in bearish_words if w in title_lower)\n",
        "    if bull_count > bear_count:\n",
        "        return \"🟢 BULLISH\", bull_count - bear_count\n",
        "    elif bear_count > bull_count:\n",
        "        return \"🔴 BEARISH\", -(bear_count - bull_count)\n",
        "    else:\n",
        "        return \"⚪ NEUTRAL\", 0\n",
        "\n",
        "def get_news_signal(positive, negative, neutral):\n",
        "    total = positive + negative + neutral\n",
        "    if total == 0:\n",
        "        return \"НЯМА ДАННИ\", 0\n",
        "    bull_pct = positive / total * 100\n",
        "    bear_pct = negative / total * 100\n",
        "    if bull_pct >= 60:   return \"STRONG BULLISH 🚀\", bull_pct\n",
        "    elif bull_pct >= 45: return \"BULLISH 📈\",         bull_pct\n",
        "    elif bear_pct >= 60: return \"STRONG BEARISH 🔴\",  bear_pct\n",
        "    elif bear_pct >= 45: return \"BEARISH 📉\",         bear_pct\n",
        "    else:                return \"NEUTRAL ⏸️\",         bull_pct\n",
