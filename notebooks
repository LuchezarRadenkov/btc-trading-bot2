      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import requests\n",
        "import time\n",
        "import plotly.graph_objects as go\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, Dense, Dropout\n",
        "from tensorflow.keras.callbacks import EarlyStopping\n",
        "\n",
        "# ── 1. Вземи исторически данни ──────────────────────────────\n",
        "def get_historical_data(days=365):\n",
        "    \"\"\"Взима данни с retry логика\"\"\"\n",
        "    for attempt in range(3):\n",
        "        try:\n",
        "            url = \"https://api.coingecko.com/api/v3/coins/bitcoin/market_chart\"\n",
        "            params = {\"vs_currency\": \"usd\", \"days\": days, \"interval\": \"daily\"}\n",
        "            r = requests.get(url, params=params, timeout=15)\n",
        "            data = r.json()\n",
        "            if \"prices\" in data:\n",
        "                prices  = data[\"prices\"]\n",
        "                volumes = data[\"total_volumes\"]\n",
        "                df = pd.DataFrame(prices, columns=[\"timestamp\", \"price\"])\n",
        "                df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], unit=\"ms\")\n",
        "                df[\"volume\"]    = [v[1] for v in volumes]\n",
        "                print(f\"✅ {len(df)} дни данни заредени от CoinGecko\")\n",
        "                return df\n",
        "            else:\n",
        "                print(f\"⚠️ Опит {attempt+1}: {data}\")\n",
        "                time.sleep(10)\n",
        "        except Exception as e:\n",
        "            print(f\"⚠️ Опит {attempt+1} грешка: {e}\")\n",
        "            time.sleep(10)\n",
        "\n",
        "    # Резервен вариант - Kraken\n",
        "    print(\"🔄 Опитвам с Kraken API...\")\n",
        "    url = \"https://api.kraken.com/0/public/OHLC\"\n",
        "    params = {\"pair\": \"XBTUSD\", \"interval\": 1440}\n",
        "    r = requests.get(url, params=params, timeout=15)\n",
        "    data = r.json()\n",
        "    result = data[\"result\"]\n",
        "    key = [k for k in result.keys() if k != \"last\"][0]\n",
        "    ohlc = result[key]\n",
        "    df = pd.DataFrame(ohlc, columns=[\n",
        "        \"timestamp\",\"open\",\"high\",\"low\",\"close\",\"vwap\",\"volume\",\"count\"\n",
        "    ])\n",
        "    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"].astype(int), unit=\"s\")\n",
        "    df[\"price\"]     = df[\"close\"].astype(float)\n",
        "    df[\"volume\"]    = df[\"volume\"].astype(float)\n",
        "    df = df[[\"timestamp\", \"price\", \"volume\"]].tail(365)\n",
        "    print(f\"✅ {len(df)} дни данни заредени от Kraken\")\n",
        "    return df\n",
        "\n",
        "# ── 2. Подготви данните ─────────────────────────────────────\n",
        "def prepare_data(df, lookback=60):\n",
        "    scaler = MinMaxScaler(feature_range=(0, 1))\n",
        "    prices_scaled = scaler.fit_transform(df[[\"price\"]])\n",
        "\n",
        "    X, y = [], []\n",
        "    for i in range(lookback, len(prices_scaled)):\n",
        "        X.append(prices_scaled[i-lookback:i, 0])\n",
        "        y.append(prices_scaled[i, 0])\n",
        "\n",
        "    X = np.array(X)\n",
        "    y = np.array(y)\n",
        "    X = X.reshape((X.shape[0], X.shape[1], 1))\n",
        "\n",
        "    split   = int(len(X) * 0.8)\n",
        "    X_train = X[:split]\n",
        "    X_test  = X[split:]\n",
        "    y_train = y[:split]\n",
        "    y_test  = y[split:]\n",
        "\n",
        "    return X_train, X_test, y_train, y_test, scaler\n",
        "\n",
        "# ── 3. Създай LSTM модел ────────────────────────────────────\n",
        "def build_model(lookback=60):\n",
        "    model = Sequential([\n",
        "        LSTM(50, return_sequences=True, input_shape=(lookback, 1)),\n",
        "        Dropout(0.2),\n",
        "        LSTM(50, return_sequences=False),\n",
        "        Dropout(0.2),\n",
        "        Dense(25),\n",
        "        Dense(1)\n",
        "    ])\n",
        "    model.compile(optimizer=\"adam\", loss=\"mean_squared_error\")\n",
        "    return model\n",
        "\n",
        "# ── 4. Предскажи следващите дни ─────────────────────────────\n",
        "def predict_future(model, df, scaler, lookback=60, days_ahead=7):\n",
        "    prices_scaled = scaler.transform(df[[\"price\"]])\n",
        "    last_sequence = prices_scaled[-lookback:]\n",
        "    predictions   = []\n",
        "\n",
        "    current_seq = last_sequence.copy()\n",
        "    for _ in range(days_ahead):\n",
        "        x    = current_seq[-lookback:].reshape(1, lookback, 1)\n",
        "        pred = model.predict(x, verbose=0)[0][0]\n",
        "        predictions.append(pred)\n",
        "        current_seq = np.append(current_seq, [[pred]], axis=0)\n",
        "\n",
        "    predictions = scaler.inverse_transform(\n",
        "        np.array(predictions).reshape(-1, 1)\n",
        "    ).flatten()\n",
        "\n",
        "    future_dates = pd.date_range(\n",
        "        start=df[\"timestamp\"].iloc[-1] + pd.Timedelta(days=1),\n",
        "        periods=days_ahead\n",
        "    )\n",
        "    return future_dates, predictions\n",
        "\n",
        "# ── Пусни всичко ────────────────────────────────────────────\n",
        "print(\"📥 Изтеглям данни...\")\n",
        "df = get_historical_data(days=365)\n",
        "print(f\"✅ {len(df)} дни данни заредени\")\n",
        "\n",
        "LOOKBACK = 60\n",
        "print(f\"\\n🔄 Подготвям данните (lookback={LOOKBACK} дни)...\")\n",
        "X_train, X_test, y_train, y_test, scaler = prepare_data(df, lookback=LOOKBACK)\n",
        "print(f\"✅ Train: {len(X_train)} | Test: {len(X_test)}\")\n",
        "\n",
        "print(f\"\\n🧠 Създавам LSTM модел...\")\n",
        "model = build_model(lookback=LOOKBACK)\n",
        "model.summary()\n",
        "\n",
        "print(f\"\\n⚙️ Тренирам модела...\")\n",
        "early_stop = EarlyStopping(monitor=\"val_loss\", patience=5, restore_best_weights=True)\n",
        "history = model.fit(\n",
        "    X_train, y_train,\n",
        "    epochs=50,\n",
        "    batch_size=32,\n",
        "    validation_split=0.1,\n",
        "    callbacks=[early_stop],\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# ── Оценка ──────────────────────────────────────────────────\n",
        "print(f\"\\n📊 Оценявам модела...\")\n",
        "y_pred_scaled = model.predict(X_test, verbose=0)\n",
        "y_pred = scaler.inverse_transform(y_pred_scaled).flatten()\n",
        "y_true = scaler.inverse_transform(y_test.reshape(-1, 1)).flatten()\n",
        "\n",
        "mae  = mean_absolute_error(y_true, y_pred)\n",
        "rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n",
        "mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100\n",
        "\n",
        "print(f\"\\n========== РЕЗУЛТАТИ НА МОДЕЛА ==========\")\n",
        "print(f\"MAE  (Mean Absolute Error):      ${mae:,.2f}\")\n",
        "print(f\"RMSE (Root Mean Squared Error):  ${rmse:,.2f}\")\n",
        "print(f\"MAPE (Mean Absolute % Error):    {mape:.2f}%\")\n",
        "print(f\"Точност:                         {100-mape:.2f}%\")\n",
        "print(f\"=========================================\")\n",
        "\n",
        "# ── Предсказване ────────────────────────────────────────────\n",
        "DAYS_AHEAD = 7\n",
        "print(f\"\\n🔮 Предсказвам следващите {DAYS_AHEAD} дни...\")\n",
        "future_dates, future_prices = predict_future(model, df, scaler, LOOKBACK, DAYS_AHEAD)\n",
        "\n",
        "current_price = df[\"price\"].iloc[-1]\n",
        "print(f\"\\n========== ПРЕДСКАЗАНИ ЦЕНИ ==========\")\n",
        "print(f\"Текуща цена: ${current_price:,.2f}\")\n",
        "print()\n",
        "for date, price in zip(future_dates, future_prices):\n",
        "    change = (price - current_price) / current_price * 100\n",
        "    emoji  = \"📈\" if price > current_price else \"📉\"\n",
        "    print(f\"{emoji} {date.strftime('%Y-%m-%d')}: ${price:,.2f} ({change:+.2f}%)\")\n",
        "\n",
        "avg_pred  = np.mean(future_prices)\n",
        "ml_signal = \"BULLISH 📈\" if avg_pred > current_price else \"BEARISH 📉\"\n",
        "print(f\"\\n🔔 ML Сигнал: {ml_signal}\")\n",
        "print(f\"======================================\")\n",
        "\n",
        "# ── Графика ─────────────────────────────────────────────────\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=df[\"timestamp\"],\n",
        "    y=df[\"price\"],\n",
        "    mode=\"lines\",\n",
        "    name=\"Реална цена\",\n",
        "    line=dict(color=\"#F7931A\", width=2)\n",
        "))\n",
        "\n",
        "test_start = LOOKBACK + int(len(df) * 0.8) - LOOKBACK\n",
        "test_dates  = df[\"timestamp\"].iloc[test_start:test_start + len(y_pred)]\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=test_dates.values,\n",
        "    y=y_pred,\n",
        "    mode=\"lines\",\n",
        "    name=\"Предсказана цена (тест)\",\n",
        "    line=dict(color=\"cyan\", width=1.5, dash=\"dot\")\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=future_dates,\n",
        "    y=future_prices,\n",
        "    mode=\"lines+markers\",\n",
        "    name=f\"Следващите {DAYS_AHEAD} дни\",\n",
        "    line=dict(color=\"lime\", width=2, dash=\"dash\"),\n",
        "    marker=dict(size=10, color=\"lime\")\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=[df[\"timestamp\"].iloc[-1], df[\"timestamp\"].iloc[-1]],\n",
        "    y=[df[\"price\"].min(), df[\"price\"].max()],\n",
        "    mode=\"lines\",\n",
        "    name=\"Сега\",\n",
        "    line=dict(color=\"white\", width=1, dash=\"dash\")\n",
        "))\n",
        "\n",
        "\n",
        "fig.update_layout(\n",
        "    title=f\"LSTM Предсказване на BTC | Точност: {100-mape:.1f}% | Сигнал: {ml_signal}\",\n",
        "    paper_bgcolor=\"#0E1117\",\n",
        "    plot_bgcolor=\"#0E1117\",\n",
        "    font=dict(color=\"white\"),\n",
        "    xaxis=dict(gridcolor=\"#1E2130\", title=\"Дата\"),\n",
        "    yaxis=dict(gridcolor=\"#1E2130\", title=\"Цена (USD)\"),\n",
        "    height=600,\n",
        "    hovermode=\"x unified\"\n",
        ")\n",
        "fig.show()\n",
        "\n",
        "# ── Loss графика ────────────────────────────────────────────\n",
        "fig2 = go.Figure()\n",
        "fig2.add_trace(go.Scatter(\n",
        "    y=history.history[\"loss\"],\n",
        "    mode=\"lines\",\n",
        "    name=\"Train Loss\",\n",
        "    line=dict(color=\"#F7931A\")\n",
        "))\n",
        "fig2.add_trace(go.Scatter(\n",
        "    y=history.history[\"val_loss\"],\n",
        "    mode=\"lines\",\n",
        "    name=\"Validation Loss\",\n",
        "    line=dict(color=\"cyan\")\n",
        "))\n",
        "fig2.update_layout(\n",
        "    title=\"Процес на обучение на модела\",\n",
        "    paper_bgcolor=\"#0E1117\",\n",
        "    plot_bgcolor=\"#0E1117\",\n",
        "    font=dict(color=\"white\"),\n",
        "    xaxis=dict(gridcolor=\"#1E2130\", title=\"Epoch\"),\n",
        "    yaxis=dict(gridcolor=\"#1E2130\", title=\"Loss\"),\n",
        "    height=400\n",
        ")\n",
        "fig2.show()"
      ]
    },
