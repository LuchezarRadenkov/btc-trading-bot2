        "else:\n",
        "    positive = 0\n",
        "    negative = 0\n",
        "    neutral  = 0\n",
        "    news_data = []\n",
        "    for news in news_list:\n",
        "        sentiment, score = analyze_sentiment_keywords(news[\"title\"])\n",
        "        if \"BULLISH\" in sentiment:  positive += 1\n",
        "        elif \"BEARISH\" in sentiment: negative += 1\n",
        "        else:                        neutral  += 1\n",
        "        news_data.append({\n",
        "            \"title\":     news[\"title\"],\n",
        "            \"sentiment\": sentiment,\n",
        "            \"score\":     score\n",
        "        })\n",
        "    signal, pct = get_news_signal(positive, negative, neutral)\n",
        "    total = positive + negative + neutral\n",
        "    print(f\"\\n========== НОВИНИ SENTIMENT ==========\")\n",
        "    print(f\"Общо новини:      {total}\")\n",
