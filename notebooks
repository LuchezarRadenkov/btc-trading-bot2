        "    max_dd = ((eq_s - peak)/peak*100).min()\n",
        "    tr = pd.DataFrame(trades)\n",
        "    wr = (len(tr[tr[\"pnl\"]>0])/len(tr)*100) if len(tr) else 0\n",
        "    rets = eq_s.pct_change().dropna()\n",
        "    sharpe = rets.mean()/rets.std()*np.sqrt(365) if rets.std()>0 else 0\n",
        "    return ret, max_dd, len(tr), wr, sharpe\n",
        "\n",
        "# ── Параметрична мрежа ──\n",
        "grid = {\n",
        "    \"trade_size\":  [30, 50, 70],\n",
        "    \"sl_pct\":      [3, 5],\n",
        "    \"tp_pct\":      [6, 10, 15],\n",
        "    \"trail_start\": [2, 4],\n",
        "    \"trail_dist\":  [1.5, 3, 5],\n",
        "}\n",
        "\n",
        "combos = list(itertools.product(*grid.values()))\n",
        "print(f\"🔬 Тествам {len(combos)} комбинации...\\n\")\n",
        "\n",
        "results = []\n",
        "for ts, sl, tp, trs, trd in combos:\n",
        "    ret, dd, n, wr, sh = run_sim_params(ts, sl, tp, trs, trd)\n",
        "    results.append({\"size%\": ts, \"SL%\": sl, \"TP%\": tp,\n",
        "                    \"trail_start\": trs, \"trail_dist\": trd,\n",
        "                    \"return%\": round(ret,1), \"maxDD%\": round(dd,1),\n",
        "                    \"trades\": n, \"winrate%\": round(wr,1),\n",
        "                    \"sharpe\": round(sh,2)})\n",
        "\n",
        "res_df = pd.DataFrame(results)\n",
        "\n",
        "# Топ 10 по доходност\n",
        "print(\"═══ ТОП 10 ПО ДОХОДНОСТ ═══\")\n",
        "print(res_df.sort_values(\"return%\", ascending=False).head(10).to_string(index=False))\n",
        "\n",
        "# Топ 10 по Sharpe (доходност спрямо риск)\n",
        "print(\"\\n═══ ТОП 10 ПО SHARPE (риск-коригирани) ═══\")\n",
        "print(res_df.sort_values(\"sharpe\", ascending=False).head(10).to_string(index=False))\n",
        "\n",
        "# Базовата линия за сравнение\n",
        "base = res_df[(res_df[\"size%\"]==30)&(res_df[\"SL%\"]==3)&(res_df[\"TP%\"]==6)&\n",
        "              (res_df[\"trail_start\"]==2)&(res_df[\"trail_dist\"]==1.5)]\n",
        "print(\"\\n═══ ТЕКУЩИТЕ НАСТРОЙКИ (базова линия) ═══\")\n",
        "print(base.to_string(index=False))"
