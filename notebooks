        "        return [\"background-color: #2a2a2a\"] * len(row)\n",
        "    st.dataframe(signals_df.style.apply(color_row, axis=1), use_container_width=True, height=400)\n",
        "else:\n",
        "    st.info(\"Все още няма записани сигнали.\")\n",
        "\n",
        "st.divider()\n",
