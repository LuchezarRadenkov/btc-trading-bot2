        "    print(f\"🔴 Bearish:       {negative} ({negative/total*100:.1f}%)\")\n",
        "    print(f\"⚪ Neutral:       {neutral}  ({neutral/total*100:.1f}%)\")\n",
        "    print(f\"📊 Сигнал:        {signal}\")\n",
        "    print(f\"======================================\")\n",
        "    print(f\"\\n========== ПОСЛЕДНИ НОВИНИ ==========\")\n",
        "    for i, news in enumerate(news_data[:15]):\n",
        "        print(f\"\\n{i+1}. {news['sentiment']} (score: {news['score']})\")\n",
        "        print(f\"   {news['title']}\")\n",
        "    print(f\"=====================================\")"
