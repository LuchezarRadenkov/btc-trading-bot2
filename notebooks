        "\n",
        "st.divider()\n",
        "\n",
        "try:\n",
        "    price       = get_btc_price()\n",
        "    signals_df  = load_signals()\n",
        "    last_signal = signals_df.iloc[-1] if not signals_df.empty else None\n",
        "    col1, col2, col3, col4 = st.columns(4)\n",
        "    col1.metric(\"💰 BTC Цена\",          f\"${price:,.2f}\")\n",
        "    col2.metric(\"📊 Последен сигнал\",   last_signal[\"signal\"] if last_signal is not None else \"—\")\n",
        "    col3.metric(\"🕐 Последна проверка\", last_signal[\"time\"]   if last_signal is not None else \"—\")\n",
