      "source": [
        "!pip install xgboost prophet -q\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import requests\n",
        "import plotly.graph_objects as go\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_percentage_error\n",
        "import xgboost as xgb\n",
        "from prophet import Prophet\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, Dense, Dropout\n",
        "from tensorflow.keras.callbacks import EarlyStopping\n",
        "\n",
        "# ── Данни ────────────────────────────────────────────────────\n",
        "def get_data(days=365):\n",
        "    url = \"https://api.kraken.com/0/public/OHLC\"\n",
        "    r = requests.get(url, params={\"pair\":\"XBTUSD\",\"interval\":1440}, timeout=15)\n",
        "    result = r.json()[\"result\"]\n",
        "    key = [k for k in result if k != \"last\"][0]\n",
        "    df = pd.DataFrame(result[key], columns=[\"ts\",\"open\",\"high\",\"low\",\"close\",\"vwap\",\"volume\",\"count\"])\n",
        "    df[\"ds\"] = pd.to_datetime(df[\"ts\"].astype(int), unit=\"s\")\n",
        "    df[\"y\"]  = df[\"close\"].astype(float)\n",
        "    return df[[\"ds\",\"y\"]].tail(days).reset_index(drop=True)\n",
        "\n",
        "df = get_data(365)\n",
        "print(f\"✅ {len(df)} дни данни\")\n",
        "\n",
        "LOOKBACK, HORIZON = 60, 7\n",
        "split = int(len(df) * 0.85)\n",
        "train, test = df[:split], df[split:]\n",
        "\n",
        "# ── Модел 1: LSTM ────────────────────────────────────────────\n",
        "print(\"🧠 Тренирам LSTM...\")\n",
        "scaler = MinMaxScaler()\n",
        "scaled = scaler.fit_transform(df[[\"y\"]])\n",
        "X, y = [], []\n",
        "for i in range(LOOKBACK, split):\n",
        "    X.append(scaled[i-LOOKBACK:i, 0]); y.append(scaled[i, 0])\n",
        "X, y = np.array(X).reshape(-1, LOOKBACK, 1), np.array(y)\n",
        "\n",
        "lstm = Sequential([LSTM(50, return_sequences=True, input_shape=(LOOKBACK,1)),\n",
        "                   Dropout(0.2), LSTM(50), Dropout(0.2), Dense(25), Dense(1)])\n",
        "lstm.compile(optimizer=\"adam\", loss=\"mse\")\n",
        "lstm.fit(X, y, epochs=30, batch_size=32, verbose=0,\n",
        "         callbacks=[EarlyStopping(patience=5, restore_best_weights=True)])\n",
        "\n",
        "def lstm_predict(days):\n",
        "    seq = scaled[-LOOKBACK:].copy()\n",
        "    preds = []\n",
        "    for _ in range(days):\n",
        "        p = lstm.predict(seq[-LOOKBACK:].reshape(1,LOOKBACK,1), verbose=0)[0][0]\n",
        "        preds.append(p); seq = np.append(seq, [[p]], axis=0)\n",
        "    return scaler.inverse_transform(np.array(preds).reshape(-1,1)).flatten()\n",
        "\n",
        "# ── Модел 2: XGBoost (с lag features) ───────────────────────\n",
        "print(\"🌳 Тренирам XGBoost...\")\n",
        "def make_features(series, lags=14):\n",
        "    feat = pd.DataFrame({\"y\": series})\n",
        "    for lag in range(1, lags+1):\n",
        "        feat[f\"lag{lag}\"] = feat[\"y\"].shift(lag)\n",
        "    feat[\"ma7\"]  = feat[\"y\"].rolling(7).mean()\n",
        "    feat[\"ma30\"] = feat[\"y\"].rolling(30).mean()\n",
        "    feat[\"ret1\"] = feat[\"y\"].pct_change()\n",
        "    return feat.dropna()\n",
        "\n",
        "feats = make_features(df[\"y\"].values)\n",
        "Xg, yg = feats.drop(\"y\", axis=1), feats[\"y\"]\n",
        "xgb_model = xgb.XGBRegressor(n_estimators=300, max_depth=5,\n",
        "                              learning_rate=0.05, random_state=42)\n",
        "xgb_model.fit(Xg[:split-44], yg[:split-44])\n",
        "\n",
        "def xgb_predict(days):\n",
        "    series = list(df[\"y\"].values)\n",
        "    preds = []\n",
        "    for _ in range(days):\n",
        "        f = make_features(pd.Series(series)).iloc[[-1]].drop(\"y\", axis=1)\n",
        "        p = float(xgb_model.predict(f)[0])\n",
        "        preds.append(p); series.append(p)\n",
        "    return np.array(preds)\n",
        "\n",
        "# ── Модел 3: Prophet ─────────────────────────────────────────\n",
        "print(\"📈 Тренирам Prophet...\")\n",
        "prophet = Prophet(daily_seasonality=True, changepoint_prior_scale=0.5)\n",
        "prophet.fit(train)\n",
        "\n",
        "def prophet_predict(days):\n",
        "    future = prophet.make_future_dataframe(periods=days)\n",
        "    fc = prophet.predict(future)\n",
        "    return fc[\"yhat\"].tail(days).values\n",
        "\n",
        "# ── ENSEMBLE: комбиниране ─────────────────────────────────────\n",
        "p_lstm    = lstm_predict(HORIZON)\n",
        "p_xgb     = xgb_predict(HORIZON)\n",
        "p_prophet = prophet_predict(HORIZON)\n",
        "\n",
        "# Тежести според историческа точност (LSTM най-добър → най-голяма)\n",
        "ensemble = 0.45*p_lstm + 0.35*p_xgb + 0.20*p_prophet\n",
        "\n",
        "current = df[\"y\"].iloc[-1]\n",
        "dates = pd.date_range(df[\"ds\"].iloc[-1] + pd.Timedelta(days=1), periods=HORIZON)\n",
        "\n",
        "print(f\"\\n========== ENSEMBLE ПРОГНОЗА ==========\")\n",
        "print(f\"Текуща цена: ${current:,.2f}\\n\")\n",
        "print(f\"{'Дата':<12} {'LSTM':>10} {'XGBoost':>10} {'Prophet':>10} {'ENSEMBLE':>10}\")\n",
        "for i, d in enumerate(dates):\n",
        "    print(f\"{d.strftime('%Y-%m-%d'):<12} ${p_lstm[i]:>9,.0f} ${p_xgb[i]:>9,.0f} \"\n",
        "          f\"${p_prophet[i]:>9,.0f} ${ensemble[i]:>9,.0f}\")\n",
        "\n",
        "avg = ensemble.mean()\n",
        "sig = \"BULLISH 📈\" if avg > current else \"BEARISH 📉\"\n",
        "print(f\"\\n🔔 Ensemble сигнал: {sig} ({(avg-current)/current*100:+.2f}%)\")\n",
        "\n",
        "# ── Графика ──────────────────────────────────────────────────\n",
        "fig = go.Figure()\n",
        "fig.add_trace(go.Scatter(x=df[\"ds\"].tail(90), y=df[\"y\"].tail(90),\n",
