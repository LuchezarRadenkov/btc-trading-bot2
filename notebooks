      "source": [
        "import pandas as pd\n",
        "import pandas_ta as ta\n",
        "import requests\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "def get_historical_data(years=5):\n",
        "    \"\"\"Взима данни от Kraken - без ограничения\"\"\"\n",
        "    print(\"Изтеглям от Kraken...\")\n",
        "    url = \"https://api.kraken.com/0/public/OHLC\"\n",
        "    params = {\"pair\": \"XBTUSD\", \"interval\": 1440}  # дневен интервал\n",
        "    r = requests.get(url, params=params, timeout=15)\n",
        "    data = r.json()\n",
        "    result = data[\"result\"]\n",
        "    key = [k for k in result.keys() if k != \"last\"][0]\n",
        "    ohlc = result[key]\n",
        "    df = pd.DataFrame(ohlc, columns=[\n",
        "        \"timestamp\",\"open\",\"high\",\"low\",\"close\",\"vwap\",\"volume\",\"count\"\n",
        "    ])\n",
        "    df[\"open_time\"] = pd.to_datetime(df[\"timestamp\"].astype(int), unit=\"s\")\n",
        "    df[\"close\"]     = df[\"close\"].astype(float)\n",
        "    df[\"high\"]      = df[\"high\"].astype(float)\n",
        "    df[\"low\"]       = df[\"low\"].astype(float)\n",
        "    df[\"open\"]      = df[\"open\"].astype(float)\n",
        "    df[\"volume\"]    = df[\"volume\"].astype(float)\n",
        "    df = df[[\"open_time\",\"open\",\"high\",\"low\",\"close\",\"volume\"]]\n",
        "    print(f\"✅ {len(df)} дни данни заредени от Kraken\")\n",
        "    return df\n",
        "\n",
        "def calculate_signals(df):\n",
        "    # RSI\n",
        "    df[\"rsi\"] = ta.rsi(df[\"close\"], length=14)\n",
        "\n",
        "    # MACD\n",
        "    macd            = ta.macd(df[\"close\"])\n",
        "    macd_col        = [c for c in macd.columns if c.startswith(\"MACD_\")][0]\n",
        "    macd_signal_col = [c for c in macd.columns if c.startswith(\"MACDs_\")][0]\n",
        "    df[\"macd\"]        = macd[macd_col]\n",
        "    df[\"macd_signal\"] = macd[macd_signal_col]\n",
        "\n",
        "    # Moving Averages\n",
        "    df[\"ema20\"]  = ta.ema(df[\"close\"], length=20)\n",
        "    df[\"ema50\"]  = ta.ema(df[\"close\"], length=50)\n",
        "    df[\"ema200\"] = ta.ema(df[\"close\"], length=200)\n",
        "\n",
        "    # Bollinger Bands\n",
        "    bb             = ta.bbands(df[\"close\"], length=20)\n",
        "    bb_upper_col   = [c for c in bb.columns if \"BBU\" in c][0]\n",
        "    bb_lower_col   = [c for c in bb.columns if \"BBL\" in c][0]\n",
        "    df[\"bb_upper\"] = bb[bb_upper_col]\n",
        "    df[\"bb_lower\"] = bb[bb_lower_col]\n",
        "\n",
        "    # Стохастик\n",
        "    stoch           = ta.stoch(df[\"high\"], df[\"low\"], df[\"close\"])\n",
        "    stoch_k_col     = [c for c in stoch.columns if \"STOCHk\" in c][0]\n",
        "    stoch_d_col     = [c for c in stoch.columns if \"STOCHd\" in c][0]\n",
        "    df[\"stoch_k\"]   = stoch[stoch_k_col]\n",
        "    df[\"stoch_d\"]   = stoch[stoch_d_col]\n",
        "\n",
        "    def get_signal(row):\n",
        "        buy  = 0\n",
        "        sell = 0\n",
        "\n",
        "        # RSI\n",
        "        if row[\"rsi\"] < 30:   buy  += 3\n",
        "        elif row[\"rsi\"] > 70: sell += 3\n",
        "        else:                  buy  += 1\n",
        "\n",
        "        # MACD\n",
        "        if row[\"macd\"] > row[\"macd_signal\"]: buy  += 2\n",
        "        else:                                 sell += 2\n",
        "\n",
        "        # EMA\n",
        "        if row[\"close\"] > row[\"ema20\"]:  buy  += 1\n",
        "        else:                             sell += 1\n",
        "        if row[\"close\"] > row[\"ema50\"]:  buy  += 1\n",
        "        else:                             sell += 1\n",
        "        if row[\"close\"] > row[\"ema200\"]: buy  += 2\n",
        "        else:                             sell += 2\n",
        "\n",
        "        # Bollinger Bands\n",
        "        if row[\"close\"] < row[\"bb_lower\"]:   buy  += 2\n",
        "        elif row[\"close\"] > row[\"bb_upper\"]: sell += 2\n",
        "\n",
        "        # Стохастик\n",
        "        if row[\"stoch_k\"] < 20:   buy  += 1\n",
        "        elif row[\"stoch_k\"] > 80: sell += 1\n",
        "\n",
        "        score = buy - sell\n",
        "        if score >= 5:    return \"STRONG BUY\",  buy, sell, score\n",
        "        elif score > 0:   return \"BUY\",          buy, sell, score\n",
        "        elif score <= -5: return \"STRONG SELL\",  buy, sell, score\n",
        "        elif score < 0:   return \"SELL\",         buy, sell, score\n",
        "        else:             return \"HOLD\",         buy, sell, score\n",
        "\n",
        "    results      = df.apply(get_signal, axis=1)\n",
        "    df[\"signal\"] = results.apply(lambda x: x[0])\n",
        "    df[\"buy\"]    = results.apply(lambda x: x[1])\n",
        "    df[\"sell\"]   = results.apply(lambda x: x[2])\n",
        "    df[\"score\"]  = results.apply(lambda x: x[3])\n",
        "\n",
        "    return df.dropna()\n",
        "\n",
        "def plot_backtest(df):\n",
        "    fig = go.Figure()\n",
        "\n",
        "    fig.add_trace(go.Scatter(\n",
        "        x=df[\"open_time\"], y=df[\"close\"],\n",
        "        mode=\"lines\", name=\"BTC Цена\",\n",
        "        line=dict(color=\"#F7931A\", width=1.5)\n",
        "    ))\n",
        "\n",
        "    colors = {\n",
        "        \"STRONG BUY\":  (\"green\",       \"🚀\", 16),\n",
        "        \"BUY\":         (\"lightgreen\",  \"📈\", 12),\n",
        "        \"STRONG SELL\": (\"red\",         \"🔴\", 16),\n",
        "        \"SELL\":        (\"lightsalmon\", \"📉\", 12),\n",
        "    }\n",
        "\n",
        "    for signal, (color, emoji, size) in colors.items():\n",
        "        mask = df[\"signal\"] == signal\n",
        "        if mask.any():\n",
        "            fig.add_trace(go.Scatter(\n",
        "                x=df[mask][\"open_time\"],\n",
        "                y=df[mask][\"close\"],\n",
        "                mode=\"markers\",\n",
        "                name=signal,\n",
        "                marker=dict(size=size, color=color, line=dict(color=\"white\", width=1)),\n",
        "                hovertemplate=(\n",
        "                    f\"<b>{signal}</b><br>\"\n",
        "                    f\"Цена: $%{{y:,.0f}}<br>\"\n",
        "                    f\"Дата: %{{x}}<extra></extra>\"\n",
        "                )\n",
        "            ))\n",
        "\n",
        "    fig.update_layout(\n",
        "        title=\"BTC/USDT — Backtest на сигналите\",\n",
        "        paper_bgcolor=\"#0E1117\",\n",
