        "    st.error(f\"Грешка при зареждане: {e}\")\n",
        "\n",
        "# Допълнителни метрики от комбинирания анализ\n",
        "try:\n",
        "    if not signals_df.empty and \"fear_greed\" in signals_df.columns:\n",
        "        last = signals_df.iloc[-1]\n",
        "        col1, col2, col3, col4 = st.columns(4)\n",
        "        col1.metric(\"📊 TradingView\",  str(last.get(\"tv_signal\", \"—\")))\n",
        "        col2.metric(\"😱 Fear & Greed\", f\"{last.get('fear_greed', '—')}/100  {last.get('fear_greed_label', '')}\")\n",
        "        col3.metric(\"📰 Новини\",       str(last.get(\"news_signal\", \"—\")))\n",
        "        col4.metric(\"⛓️ On-Chain\",      str(last.get(\"onchain_signal\", \"—\")))\n",
        "except Exception as e:\n",
        "    pass\n",
        "\n",
        "st.divider()\n",
        "st.subheader(\"📈 BTC/USDT — пълна история\")\n",
        "\n",
        "try:\n",
        "    hist       = get_btc_history()\n",
        "    signals_df = load_signals()\n",
        "    fig        = go.Figure()\n",
        "    fig.add_trace(go.Scatter(\n",
        "        x=hist[\"open_time\"], y=hist[\"close\"],\n",
        "        mode=\"lines\", name=\"BTC Цена\",\n",
        "        line=dict(color=\"#F7931A\", width=2)\n",
        "    ))\n",
        "    if not signals_df.empty and \"signal\" in signals_df.columns:\n",
        "        signals_df[\"time\"] = pd.to_datetime(signals_df[\"time\"])\n",
        "        signals_df[\"time\"] = signals_df[\"time\"].dt.tz_localize(\"Europe/Sofia\", ambiguous=\"NaT\", nonexistent=\"NaT\")\n",
        "        for _, row in signals_df.iterrows():\n",
        "            color = signal_color(row[\"signal\"])\n",
        "            emoji = signal_emoji(row[\"signal\"])\n",
        "            fig.add_trace(go.Scatter(\n",
        "                x=[row[\"time\"]], y=[row[\"price\"]],\n",
        "                mode=\"markers+text\",\n",
        "                marker=dict(size=20, color=color, line=dict(color=\"white\", width=2)),\n",
        "                text=[emoji], textposition=\"top center\",\n",
        "                textfont=dict(size=20),\n",
        "                name=str(row[\"signal\"]),\n",
        "                hovertemplate=(\n",
        "                    f\"<b>{row['signal']}</b><br>\"\n",
        "                    f\"Цена: ${row['price']:,.2f}<br>\"\n",
        "                    f\"Час: {row['time']}<extra></extra>\"\n",
        "                )\n",
        "            ))\n",
        "    fig.update_layout(\n",
        "        paper_bgcolor=\"#0E1117\", plot_bgcolor=\"#0E1117\",\n",
        "        font=dict(color=\"white\"),\n",
        "        xaxis=dict(gridcolor=\"#1E2130\", title=\"Час\"),\n",
        "        yaxis=dict(\n",
        "            gridcolor=\"#1E2130\",\n",
        "            title=\"Цена (USD)\",\n",
        "            range=[hist[\"close\"].min() * 0.995, hist[\"close\"].max() * 1.005]\n",
        "        ),\n",
        "        legend=dict(bgcolor=\"#1E2130\"),\n",
        "        height=500, showlegend=False, hovermode=\"x unified\"\n",
        "    )\n",
        "    st.plotly_chart(fig, use_container_width=True)\n",
        "except Exception as e:\n",
        "    st.error(f\"Грешка при графиката: {e}\")\n",
        "\n",
        "st.divider()\n",
        "st.subheader(\"📋 История на сигналите\")\n",
        "signals_df = load_signals()\n",
        "if not signals_df.empty:\n",
        "    signals_df = signals_df.sort_values(\"time\", ascending=False).reset_index(drop=True)\n",
        "    def color_row(row):\n",
        "        s = str(row.get(\"signal\", \"\")).upper()\n",
        "        if \"BUY\" in s:  return [\"background-color: #1a3d1a\"] * len(row)\n",
