        "!pip install shap -q\n",
        "import shap\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# SHAP работи най-добре с XGBoost модела от клетка 13\n",
        "explainer = shap.TreeExplainer(xgb_model)\n",
        "shap_values = explainer.shap_values(Xg.tail(100))\n",
        "\n",
        "print(\"========== SHAP АНАЛИЗ ==========\")\n",
        "print(\"Кои фактори влияят най-много на предсказанието:\\n\")\n",
        "\n",
        "# 1. Обобщена важност на факторите\n",
        "plt.figure(figsize=(10, 6))\n",
        "shap.summary_plot(shap_values, Xg.tail(100), plot_type=\"bar\",\n",
        "                  show=False, color=\"#F7931A\")\n",
        "plt.title(\"Важност на факторите за прогнозата (SHAP)\", color=\"white\")\n",
        "plt.gcf().set_facecolor(\"#0E1117\")\n",
        "plt.gca().set_facecolor(\"#0E1117\")\n",
        "plt.gca().tick_params(colors=\"white\")\n",
        "plt.gca().xaxis.label.set_color(\"white\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 2. Детайлен summary plot (посока на влиянието)\n",
        "plt.figure(figsize=(10, 6))\n",
        "shap.summary_plot(shap_values, Xg.tail(100), show=False)\n",
        "plt.gcf().set_facecolor(\"#0E1117\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 3. Обяснение на ПОСЛЕДНОТО предсказание\n",
        "print(\"\\n========== ЗАЩО МОДЕЛЪТ ПРЕДСКАЗВА ТАКА? ==========\")\n",
        "last_shap = shap_values[-1]\n",
        "last_features = Xg.tail(1).iloc[0]\n",
        "contributions = sorted(zip(Xg.columns, last_shap, last_features),\n",
        "                       key=lambda x: abs(x[1]), reverse=True)\n",
        "print(f\"{'Фактор':<10} {'Стойност':>12} {'Принос ($)':>12}\")\n",
        "for name, sv, val in contributions[:8]:\n",
        "    arrow = \"⬆️\" if sv > 0 else \"⬇️\"\n",
        "    print(f\"{name:<10} {val:>12,.0f} {sv:>+11,.0f} {arrow}\")\n",
        "print(f\"\\nБазова стойност: ${explainer.expected_value:,.0f}\")\n",
        "print(f\"Финално предсказание: ${explainer.expected_value + last_shap.sum():,.0f}\")"
      ]
    },
